package com.coffeepeek.designsystem

import androidx.compose.material3.ColorScheme
import androidx.compose.material3.Typography
import androidx.compose.material3.darkColorScheme
import androidx.compose.material3.lightColorScheme
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.text.TextStyle
import androidx.compose.ui.text.font.Font
import androidx.compose.ui.text.font.FontFamily
import androidx.compose.ui.text.font.FontWeight
import androidx.compose.ui.unit.dp
import androidx.compose.ui.unit.sp

// ─── Brand colors ───────────────────────────────────────────────────────────
object CoffeePeekColors {
    val Primary = Color(0xFFEAB308)
    val PrimaryHover = Color(0xFFFACC15)
    val PrimaryDark = Color(0xFFCA8A04)
    val GoldWarm = Color(0xFFD4A84B)
    val Success = Color(0xFF22C55E)
    val Error = Color(0xFFEF4444)

    // Dark theme
    val DarkBackground = Color(0xFF1A1412)
    val DarkSurface = Color(0xFF2D241F)
    val DarkTextPrimary = Color(0xFFFFFFFF)
    val DarkTextSecondary = Color(0xFFA39E93)
    val DarkBorder = Color(0xFF3D2F28)

    // Light theme
    val LightBackground = Color(0xFFFAFAF9)
    val LightSurface = Color(0xFFFFFFFF)
    val LightTextPrimary = Color(0xFF1C1917)
    val LightTextSecondary = Color(0xFF78716C)
    val LightBorder = Color(0xFFE7E5E4)
}

// ─── Material 3 ColorScheme mapping ─────────────────────────────────────────
val CoffeePeekDarkColorScheme: ColorScheme = darkColorScheme(
    primary = CoffeePeekColors.Primary,
    onPrimary = Color(0xFF1A1412),
    primaryContainer = CoffeePeekColors.PrimaryDark,
    onPrimaryContainer = Color(0xFF1A1412),
    secondary = CoffeePeekColors.GoldWarm,
    background = CoffeePeekColors.DarkBackground,
    onBackground = CoffeePeekColors.DarkTextPrimary,
    surface = CoffeePeekColors.DarkSurface,
    onSurface = CoffeePeekColors.DarkTextPrimary,
    surfaceVariant = Color(0xFF3D2F28),
    onSurfaceVariant = CoffeePeekColors.DarkTextSecondary,
    outline = CoffeePeekColors.DarkBorder,
    error = CoffeePeekColors.Error,
)

val CoffeePeekLightColorScheme: ColorScheme = lightColorScheme(
    primary = CoffeePeekColors.Primary,
    onPrimary = Color(0xFF1A1412),
    primaryContainer = Color(0xFFFEF3C7),
    onPrimaryContainer = Color(0xFF1A1412),
    secondary = CoffeePeekColors.GoldWarm,
    background = CoffeePeekColors.LightBackground,
    onBackground = CoffeePeekColors.LightTextPrimary,
    surface = CoffeePeekColors.LightSurface,
    onSurface = CoffeePeekColors.LightTextPrimary,
    surfaceVariant = Color(0xFFF3F4F6),
    onSurfaceVariant = CoffeePeekColors.LightTextSecondary,
    outline = CoffeePeekColors.LightBorder,
    error = CoffeePeekColors.Error,
)

// ─── Typography ─────────────────────────────────────────────────────────────
// Положите .otf файлы RF Dewi Expanded в res/font/
// val DisplayFont = FontFamily(Font(R.font.rf_dewi_expanded_bold, FontWeight.Bold))
// val BodyFont = FontFamily(Font(R.font.noto_sans_regular))

val CoffeePeekTypography = Typography(
    displayLarge = TextStyle(
        fontSize = 88.sp,
        fontWeight = FontWeight.Black,
        letterSpacing = (-0.045).sp,
        lineHeight = 84.sp,
    ),
    headlineLarge = TextStyle(fontSize = 36.sp, fontWeight = FontWeight.Bold, letterSpacing = (-0.02).sp),
    headlineMedium = TextStyle(fontSize = 24.sp, fontWeight = FontWeight.Bold, letterSpacing = (-0.025).sp),
    titleLarge = TextStyle(fontSize = 20.sp, fontWeight = FontWeight.Bold),
    bodyLarge = TextStyle(fontSize = 16.sp, fontWeight = FontWeight.Normal),
    bodyMedium = TextStyle(fontSize = 14.sp, fontWeight = FontWeight.Normal),
    labelLarge = TextStyle(fontSize = 16.sp, fontWeight = FontWeight.SemiBold),
    labelMedium = TextStyle(fontSize = 14.sp, fontWeight = FontWeight.Medium),
    labelSmall = TextStyle(fontSize = 12.sp, fontWeight = FontWeight.Medium),
)

// ─── Component dimensions ───────────────────────────────────────────────────
object CoffeePeekDimens {
    val ButtonHeight = 40.dp
    val ButtonRadius = 12.dp
    val ButtonPaddingH = 16.dp

    val InputMinHeight = 52.dp
    val InputRadius = 26.dp
    val InputPadding = 16.dp

    val SelectMinHeight = 56.dp
    val SelectRadius = 16.dp

    val CardRadius = 16.dp
    val CardPadding = 24.dp

    val HeaderHeight = 64.dp
    val HeaderLogoSize = 40.dp

    val Spacing2 = 8.dp
    val Spacing3 = 12.dp
    val Spacing4 = 16.dp
    val Spacing6 = 24.dp
}
