<?xml version="1.0" encoding="utf-8"?>
<!--
  CoffeePeek Design System — Android colors.xml
  Скопируйте в: app/src/main/res/values/colors.xml
  Для тёмной темы: app/src/main/res/values-night/colors.xml (переопределите theme_*)
-->
<resources>
    <!-- Brand -->
    <color name="brand_primary">#EAB308</color>
    <color name="brand_primary_hover">#FACC15</color>
    <color name="brand_primary_dark">#CA8A04</color>
    <color name="brand_primary_light">#FEF3C7</color>
    <color name="brand_gold_warm">#D4A84B</color>
    <color name="brand_gold_warm_hover">#B68A2E</color>
    <color name="brand_gold_warm_soft">#F8F1DD</color>

    <!-- Semantic -->
    <color name="semantic_success">#22C55E</color>
    <color name="semantic_error">#EF4444</color>
    <color name="semantic_warning">#EAB308</color>
    <color name="semantic_info">#3B82F6</color>

    <!-- Light theme (default values/) -->
    <color name="theme_background">#FAFAF9</color>
    <color name="theme_surface">#FFFFFF</color>
    <color name="theme_surface_alt">#F9F8F6</color>
    <color name="theme_card">#FFFFFF</color>
    <color name="theme_input">#FFFFFF</color>
    <color name="theme_badge">#F3F4F6</color>
    <color name="theme_text_primary">#1C1917</color>
    <color name="theme_text_secondary">#78716C</color>
    <color name="theme_text_muted">#75706B</color>
    <color name="theme_text_tertiary">#6B7280</color>
    <color name="theme_text_on_primary">#1A1412</color>
    <color name="theme_border">#E7E5E4</color>
    <color name="theme_border_subtle">#E5E1DA</color>
    <color name="theme_border_hover">#D1D5DB</color>
    <color name="theme_overlay">#80000000</color>

    <!-- Component-specific (light) -->
    <color name="button_primary_bg">@color/brand_primary</color>
    <color name="button_primary_text">@color/theme_text_on_primary</color>
    <color name="input_focus_border">@color/brand_primary</color>
    <color name="input_focus_ring">#1AEAB308</color>
</resources>
